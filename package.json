{
  "name": "poko-alive-on-desktop",
  "version": "0.1.2",
  "private": true,
  "description": "Poko and Loko — transparent animated desktop pets for Windows.",
  "author": "Hasan Bukhari",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.electron.json",
    "validate:assets": "node scripts/validate-assets.mjs",
    "check": "npm run validate:assets && npm run typecheck && npm run build"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.2",
    "vite": "^8.1.5"
  },
  "build": {
    "appId": "com.hasan.poko",
    "productName": "Poko",
    "publish": null,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "public/icons",
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Poko-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
